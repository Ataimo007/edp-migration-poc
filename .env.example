# Copy this file to .env and fill in DASH_LICENSE before running up.sh or
# docker compose up. See README.md "Prerequisites" for how to get a trial
# license.
DASH_LICENSE=add_your_tyk_trial_license_here

# EDP's own bootstrap admin (created fresh on its first boot, against an
# empty tyk_portal database). up.sh generates a random value for both the
# first time it writes .env — leave these blank and let it. Overrides
# whatever's in confs/tyk_portal.env (which only holds a generic
# placeholder now, never a real value — see that file's own comment).
EDP_ADMIN_EMAIL=
EDP_ADMIN_PASSWORD=

# Component versions — safe to leave at the defaults below.
GATEWAY_VERSION=v5.13.2
DASHBOARD_VERSION=v5.13.2
PORTAL_VERSION=v1.17.3
PUMP_VERSION=v1.17.0
KEYCLOAK_VERSION=latest

# The published edp-migrate image to run — Docker Hub by default; swap
# for ghcr.io/ataimo007/edp-migrate:latest to use GitHub Container
# Registry instead, or pin an exact version (e.g. :0.1.3) rather than
# always tracking :latest.
EDP_MIGRATE_IMAGE=docker.io/ataimo007/edp-migrate:latest

# Keycloak's own admin console login (separate from the Tyk Dashboard/EDP
# credentials up.sh prints).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin1234

# Host-side ports. Plain/standard values by default (won't collide with
# THIS stack, but will with any other Tyk/Postgres/Redis/Keycloak already
# running on your machine on their own standard ports). Run
# `./up.sh --dev-ports` to switch these to the exact values edp-migrate's
# own Setup wizard prefills out of the box (DefaultLocalConfig, in the
# core tool's own repo) instead — it rewrites the six lines below in
# place — which trades "avoids colliding with a real local stack" for
# "the wizard needs zero manual configuration to find this one."
DASHBOARD_HOST_PORT=3000
PORTAL_HOST_PORT=3001
GATEWAY_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
KEYCLOAK_HOST_PORT=8180
EDP_MIGRATE_HOST_PORT=9090
MONGO_HOST_PORT=27017
HTTPBIN_HOST_PORT=8091
