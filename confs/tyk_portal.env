# Generic placeholders only — up.sh always overrides both with a freshly
# generated value via .env's EDP_ADMIN_EMAIL/EDP_ADMIN_PASSWORD
# (docker-compose.yml's own `environment:` block on this service takes
# precedence over this file). Never put a real personal email/password
# here — this file is committed and gets mirrored to the public repo.
ADMIN_EMAIL=admin@example-poc.dev
ADMIN_PASSWORD=change-me-see-env-example
PORTAL_HOST_PORT=3001
PORTAL_REFRESHINTERVAL=10
PORTAL_DATABASE_DIALECT=postgres
PORTAL_DATABASE_CONNECTIONSTRING=user=postgres password=topsecretpassword host=tyk-postgres port=5432 database=tyk_portal sslmode=disable
PORTAL_DATABASE_ENABLELOGS=false
PORTAL_THEMING_THEME=default
PORTAL_THEMING_PATH=./themes
PORTAL_TIB_ENABLED=true
PORTAL_AUDITLOG_ENABLE=true
PORTAL_AUDITLOG_PATH=/opt/portal/audit-logs